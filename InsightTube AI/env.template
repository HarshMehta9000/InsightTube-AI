# YouTube AI Data Engineering Analysis Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development
DEBUG=true
APP_NAME=YouTube Data Engineering Analysis
APP_VERSION=1.0.0

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MongoDB
MONGODB_URI=mongodb://admin:password123@localhost:27017/youtube_analysis?authSource=admin
MONGODB_DATABASE=youtube_analysis

# PostgreSQL
POSTGRES_URI=postgresql://youtube_user:youtube_pass@localhost:5432/youtube_analysis
POSTGRES_USER=youtube_user
POSTGRES_PASSWORD=youtube_pass
POSTGRES_DB=youtube_analysis

# Redis
REDIS_URL=redis://:redis123@localhost:6379/0
REDIS_DB=0

# Connection Pool Settings
MAX_CONNECTIONS=10
CONNECTION_TIMEOUT=30

# =============================================================================
# CLOUD SERVICES
# =============================================================================
# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=youtube-data-bucket
AWS_GLUE_DATABASE=db_youtube_raw
AWS_GLUE_TABLE=raw_statistics

# Google Cloud Platform
GOOGLE_APPLICATION_CREDENTIALS=path_to_your_gcp_service_account_key.json
GCP_PROJECT_ID=your_gcp_project_id
GCP_BUCKET_NAME=youtube-data-bucket-gcp

# Azure Configuration
AZURE_CONNECTION_STRING=your_azure_connection_string
AZURE_CONTAINER_NAME=youtube-data-container

# =============================================================================
# AI SERVICES
# =============================================================================
# OpenAI Configuration
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=2000

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Vector Database Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_INDEX_NAME=youtube-analysis

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db

# =============================================================================
# API CONFIGURATION
# =============================================================================
# YouTube Data API v3
YOUTUBE_API_KEY=AIza-your_youtube_api_key_here
YOUTUBE_API_QUOTA_LIMIT=10000

# Application API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# CORS Settings
CORS_ORIGINS=["*"]
CORS_METHODS=["GET", "POST", "PUT", "DELETE"]

# =============================================================================
# DATA PROCESSING CONFIGURATION
# =============================================================================
# Apache Spark Settings
SPARK_MASTER=local[*]
SPARK_APP_NAME=YouTubeAnalysis
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# Batch Processing
BATCH_SIZE=1000
MAX_WORKERS=4

# Data Retention
DATA_RETENTION_DAYS=365
BACKUP_ENABLED=true

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=100
LOG_BACKUP_COUNT=5

# Structured Logging
ENABLE_STRUCTURED_LOGGING=true
LOG_CORRELATION_ID=true

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Authentication
SECRET_KEY=your_super_secret_key_here_make_it_long_and_random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Security
ENABLE_API_KEY_AUTH=true
ENABLE_JWT_AUTH=true

# Data Encryption
ENABLE_ENCRYPTION=true
ENCRYPTION_KEY=your_encryption_key_here

# =============================================================================
# MONITORING AND OBSERVABILITY
# =============================================================================
# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ENABLED=true
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin123

# MLflow
MLFLOW_ENABLED=true
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000

# =============================================================================
# EXTERNAL INTEGRATIONS
# =============================================================================
# Social Media APIs
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# Web Scraping
SCRAPING_ENABLED=true
SCRAPING_DELAY=1
SCRAPING_USER_AGENT=Mozilla/5.0 (compatible; YouTubeAnalysis/1.0)

# IoT and Sensors
IOT_ENABLED=false
IOT_ENDPOINT=your_iot_endpoint

# =============================================================================
# DEVELOPMENT AND TESTING
# =============================================================================
# Testing
TEST_DATABASE_URL=sqlite:///./test.db
TEST_MONGODB_URI=mongodb://localhost:27017/test_youtube_analysis

# Development Tools
ENABLE_DEBUG_TOOLBAR=false
ENABLE_PROFILING=false

# =============================================================================
# DEPLOYMENT
# =============================================================================
# Docker
DOCKER_ENABLED=true
DOCKER_REGISTRY=your_registry.com
DOCKER_IMAGE_TAG=latest

# Kubernetes
K8S_ENABLED=false
K8S_NAMESPACE=youtube-analysis
K8S_REPLICAS=3

# =============================================================================
# BACKUP AND RECOVERY
# =============================================================================
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=./backups

# =============================================================================
# NOTIFICATIONS
# =============================================================================
# Email
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Slack
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=your_slack_webhook_url

# Discord
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=your_discord_webhook_url
